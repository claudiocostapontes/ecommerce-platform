:host {
    display: block;
}

/* =========================================
   HERO
   ========================================= */

.hero {
    position: relative;
    overflow: hidden;

    background:
            radial-gradient(
                    circle at 84% 18%,
                    rgb(217 97 34 / 0.11),
                    transparent 25%
            ),
            radial-gradient(
                    circle at 68% 80%,
                    rgb(16 42 79 / 0.08),
                    transparent 30%
            ),
            linear-gradient(
                    135deg,
                    #f8fafc 0%,
                    #ffffff 55%,
                    #f7f3ee 100%
            );

    border-bottom: 1px solid var(--color-gray-100);
}

.hero-grid {
    min-height: 570px;

    display: grid;
    grid-template-columns: 1.05fr 0.95fr;

    align-items: center;

    gap: var(--space-16);

    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
}

.hero-eyebrow,
.section-eyebrow {
    display: inline-flex;

    color: var(--color-accent-600);

    font-size: var(--font-size-sm);
    font-weight: 800;

    letter-spacing: 0.09em;
    text-transform: uppercase;
}

.hero-content h1 {
    max-width: 680px;

    margin-top: var(--space-4);

    color: var(--color-primary-900);

    font-size: clamp(3rem, 5vw, 4.7rem);
    font-weight: 850;

    line-height: 0.98;
    letter-spacing: -0.065em;
}

.hero-content h1 span {
    display: block;

    color: var(--color-accent-600);
}

.hero-description {
    max-width: 620px;

    margin-top: var(--space-6);

    color: var(--color-gray-600);

    font-size: var(--font-size-lg);
    line-height: 1.75;
}

.hero-actions {
    display: flex;

    align-items: center;

    gap: var(--space-6);

    margin-top: var(--space-8);
}

.hero-primary {
    min-height: 48px;

    display: inline-flex;

    align-items: center;
    justify-content: center;

    gap: var(--space-3);

    padding: 0 var(--space-6);

    background: var(--color-accent-600);
    color: var(--color-white);

    border-radius: var(--radius-md);

    box-shadow: var(--shadow-sm);

    font-weight: 800;

    transition:
            background var(--transition-fast),
            transform var(--transition-fast),
            box-shadow var(--transition-fast);
}

.hero-primary:hover {
    background: var(--color-accent-700);

    box-shadow: var(--shadow-md);

    transform: translateY(-2px);
}

.hero-secondary {
    color: var(--color-primary-900);

    font-weight: 750;
}

.hero-secondary:hover {
    color: var(--color-accent-600);
}

.hero-trust {
    display: flex;

    gap: var(--space-8);

    margin-top: var(--space-12);
    padding-top: var(--space-6);

    border-top: 1px solid var(--color-gray-200);
}

.hero-trust div {
    display: flex;
    flex-direction: column;
}

.hero-trust strong {
    color: var(--color-primary-900);

    font-size: var(--font-size-sm);
}

.hero-trust span {
    margin-top: 3px;

    color: var(--color-gray-500);

    font-size: var(--font-size-xs);
}

/* =========================================
   HERO PRODUCT
   ========================================= */

.hero-showcase {
    position: relative;

    min-height: 440px;

    display: grid;
    place-items: center;
}

.showcase-decoration {
    position: absolute;

    width: 430px;
    height: 430px;

    background: rgb(217 97 34 / 0.08);

    border-radius: 50%;

    filter: blur(2px);
}

.showcase-card {
    position: relative;
    z-index: 2;

    width: min(100%, 520px);
    min-height: 400px;

    display: flex;
    flex-direction: column;

    justify-content: space-between;

    padding: var(--space-8);

    background:
            rgb(255 255 255 / 0.8);

    border:
            1px solid
            rgb(255 255 255 / 0.95);

    border-radius: var(--radius-xl);

    box-shadow: var(--shadow-lg);

    backdrop-filter: blur(20px);
}

.showcase-header,
.showcase-footer {
    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: var(--space-4);
}

.offer-badge {
    padding: 7px 11px;

    background: var(--color-accent-50);
    color: var(--color-accent-700);

    border-radius: var(--radius-full);

    font-size: var(--font-size-xs);
    font-weight: 800;
}

.showcase-brand {
    color: var(--color-gray-500);

    font-size: var(--font-size-xs);
    font-weight: 800;

    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.tv-product {
    width: 88%;

    align-self: center;
}

.tv-screen {
    position: relative;
    overflow: hidden;

    aspect-ratio: 16 / 9;

    background:
            radial-gradient(
                    circle at 76% 24%,
                    #d97732 0,
                    #be5420 18%,
                    transparent 43%
            ),
            radial-gradient(
                    circle at 28% 65%,
                    #244c82,
                    transparent 38%
            ),
            linear-gradient(
                    135deg,
                    #07172f,
                    #102a4f 55%,
                    #07111f
            );

    border: 7px solid #091426;

    border-radius: 9px;

    box-shadow:
            0 24px 42px
            rgb(7 23 47 / 0.23);
}

.screen-light {
    position: absolute;

    border-radius: 50%;

    filter: blur(3px);
}

.light-one {
    right: -10%;
    bottom: -45%;

    width: 65%;

    aspect-ratio: 1;

    background:
            rgb(232 121 50 / 0.28);
}

.light-two {
    left: 5%;
    top: 3%;

    width: 35%;

    aspect-ratio: 1;

    background:
            rgb(43 94 159 / 0.27);
}

.screen-text {
    position: absolute;

    left: 8%;
    bottom: 12%;

    display: flex;
    flex-direction: column;

    color: var(--color-white);
}

.screen-text small {
    font-size: 0.65rem;

    letter-spacing: 0.18em;
}

.screen-text strong {
    margin-top: 3px;

    font-size: 2.8rem;

    line-height: 1;
}

.screen-text span {
    margin-top: 5px;

    color: #d0d5dd;

    font-size: var(--font-size-xs);
}

.tv-base {
    width: 31%;
    height: 22px;

    margin: 0 auto;

    border-bottom:
            5px solid
            #344054;

    transform:
            perspective(60px)
            rotateX(45deg);
}

.showcase-footer > div {
    display: flex;
    flex-direction: column;
}

.showcase-footer small {
    color: var(--color-gray-500);

    font-size: var(--font-size-xs);
}

.showcase-footer strong {
    margin-top: 2px;

    color: var(--color-primary-900);

    font-size: var(--font-size-base);
}

.showcase-arrow {
    width: 38px;
    height: 38px;

    display: grid;
    place-items: center;

    background: var(--color-primary-900);
    color: var(--color-white);

    border-radius: var(--radius-full);
}

/* =========================================
   BENEFITS
   ========================================= */

.benefits {
    background: var(--color-white);

    border-bottom:
            1px solid
            var(--color-border);
}

.benefits-grid {
    min-height: 105px;

    display: grid;

    grid-template-columns:
    repeat(4, 1fr);

    align-items: center;
}

.benefit {
    min-width: 0;

    display: flex;

    align-items: center;

    gap: var(--space-3);

    padding:
            0
            var(--space-6);

    border-right:
            1px solid
            var(--color-border);
}

.benefit:first-child {
    padding-left: 0;
}

.benefit:last-child {
    border-right: 0;
}

.benefit-icon {
    flex: 0 0 40px;

    width: 40px;
    height: 40px;

    display: grid;
    place-items: center;

    background: var(--color-primary-50);
    color: var(--color-primary-600);

    border-radius: var(--radius-md);

    font-weight: 900;
}

.benefit div {
    min-width: 0;

    display: flex;
    flex-direction: column;
}

.benefit strong {
    color: var(--color-primary-900);

    font-size: var(--font-size-sm);
}

.benefit div span {
    margin-top: 2px;

    color: var(--color-gray-500);

    font-size: var(--font-size-xs);
}

/* =========================================
   SECTIONS
   ========================================= */

.categories-section,
.products-section,
.store-section {
    padding:
            var(--space-20)
            0;
}

.categories-section {
    background: var(--color-white);
}

.products-section {
    background: var(--color-gray-50);
}

.section-heading {
    display: flex;

    align-items: flex-end;
    justify-content: space-between;

    gap: var(--space-6);

    margin-bottom: var(--space-8);
}

.section-heading h2 {
    margin-top: var(--space-2);

    color: var(--color-primary-900);

    font-size:
            clamp(
                    1.8rem,
                    3vw,
                    2.5rem
            );

    line-height: 1.1;

    letter-spacing: -0.045em;
}

.section-heading > a {
    display: inline-flex;

    align-items: center;

    gap: var(--space-2);

    color: var(--color-primary-600);

    font-size: var(--font-size-sm);
    font-weight: 800;
}

/* =========================================
   CATEGORIES
   ========================================= */

.category-grid {
    display: grid;

    grid-template-columns:
    repeat(3, 1fr);

    gap: var(--space-5);
}

.category-card {
    min-height: 135px;

    display: flex;

    align-items: center;

    gap: var(--space-5);

    padding: var(--space-6);

    background: var(--color-white);

    border:
            1px solid
            var(--color-border);

    border-radius: var(--radius-lg);

    transition:
            transform var(--transition-normal),
            border-color var(--transition-normal),
            box-shadow var(--transition-normal);
}

.category-card:hover {
    border-color:
            var(--color-primary-100);

    box-shadow: var(--shadow-md);

    transform: translateY(-3px);
}

.category-icon {
    flex: 0 0 60px;

    width: 60px;
    height: 60px;

    display: grid;
    place-items: center;

    background: var(--color-primary-50);
    color: var(--color-primary-600);

    border-radius: var(--radius-lg);

    font-size: var(--font-size-2xl);
}

.category-copy {
    min-width: 0;

    display: flex;
    flex-direction: column;

    gap: 6px;
}

.category-copy strong {
    color: var(--color-primary-900);

    font-size: var(--font-size-lg);
}

.category-copy small {
    color: var(--color-gray-500);
}

.skeleton-category {
    background:
            linear-gradient(
                    90deg,
                    var(--color-gray-50),
                    var(--color-gray-100),
                    var(--color-gray-50)
            );

    background-size: 200% 100%;

    animation:
            pulseBackground
            1.5s infinite;
}

/* =========================================
   PRODUCTS
   ========================================= */

.product-grid {
    display: grid;

    grid-template-columns:
    repeat(4, minmax(0, 1fr));

    gap: var(--space-5);
}

.product-card {
    overflow: hidden;

    background: var(--color-white);

    border:
            1px solid
            var(--color-border);

    border-radius: var(--radius-lg);

    transition:
            transform var(--transition-normal),
            border-color var(--transition-normal),
            box-shadow var(--transition-normal);
}

.product-card:hover {
    border-color:
            var(--color-gray-300);

    box-shadow: var(--shadow-md);

    transform: translateY(-4px);
}

.product-media {
    position: relative;

    aspect-ratio: 1 / 0.87;

    display: grid;
    place-items: center;

    padding: var(--space-6);

    background:
            linear-gradient(
                    145deg,
                    var(--color-gray-25),
                    var(--color-gray-50)
            );
}

.product-image {
    width: 100%;
    height: 100%;

    object-fit: contain;
}

.discount-badge {
    position: absolute;

    top: var(--space-4);
    left: var(--space-4);

    z-index: 2;

    padding: 6px 10px;

    background: var(--color-accent-600);
    color: var(--color-white);

    border-radius: var(--radius-sm);

    font-size: var(--font-size-xs);
    font-weight: 850;
}

.favorite-button {
    position: absolute;

    top: var(--space-4);
    right: var(--space-4);

    z-index: 2;

    width: 38px;
    height: 38px;

    display: grid;
    place-items: center;

    background: var(--color-white);
    color: var(--color-primary-900);

    border:
            1px solid
            var(--color-border);

    border-radius: var(--radius-full);

    font-size: var(--font-size-lg);
}

.favorite-button:hover {
    color: var(--color-accent-600);

    border-color:
            var(--color-accent-100);
}

.product-placeholder {
    width: 78%;
}

.mini-tv {
    width: 100%;
}

.mini-tv-screen {
    aspect-ratio: 16 / 9;

    background:
            radial-gradient(
                    circle at 75% 20%,
                    #d96122,
                    transparent 32%
            ),
            linear-gradient(
                    135deg,
                    #07172f,
                    #17345f
            );

    border:
            5px solid
            #091426;

    border-radius: 7px;

    box-shadow: var(--shadow-md);
}

.mini-tv-base {
    width: 30%;
    height: 13px;

    margin: 0 auto;

    border-bottom:
            4px solid
            #475467;
}

.product-info {
    padding: var(--space-5);
}

.product-brand {
    color: var(--color-accent-600);

    font-size: var(--font-size-xs);
    font-weight: 800;

    letter-spacing: 0.07em;
    text-transform: uppercase;
}

.product-info h3 {
    min-height: 48px;

    margin-top: var(--space-2);

    color: var(--color-primary-900);

    font-size: var(--font-size-base);

    line-height: 1.45;
}

.rating {
    display: flex;

    align-items: center;

    gap: var(--space-2);

    margin-top: var(--space-3);

    color: var(--color-gray-500);

    font-size: var(--font-size-xs);
}

.rating-stars {
    color: #e5a43b;

    letter-spacing: -2px;
}

.pricing {
    min-height: 98px;

    display: flex;
    flex-direction: column;

    justify-content: flex-end;

    margin-top: var(--space-4);
}

.previous-price {
    color: var(--color-gray-500);

    font-size: var(--font-size-sm);

    text-decoration: line-through;
}

.current-price {
    color: var(--color-primary-900);

    font-size: var(--font-size-2xl);

    line-height: 1.2;

    letter-spacing: -0.04em;
}

.installment {
    margin-top: 4px;

    color: var(--color-gray-500);

    font-size: var(--font-size-xs);
}

.product-button {
    min-height: 45px;

    display: flex;

    align-items: center;
    justify-content: center;

    margin-top: var(--space-5);

    background: var(--color-primary-900);
    color: var(--color-white);

    border-radius: var(--radius-md);

    font-size: var(--font-size-sm);
    font-weight: 800;

    transition:
            background
            var(--transition-fast);
}

.product-button:hover {
    background: var(--color-accent-600);
}

.empty-products {
    padding: var(--space-16);

    display: flex;
    flex-direction: column;

    align-items: center;

    text-align: center;

    background: var(--color-white);

    border:
            1px dashed
            var(--color-gray-300);

    border-radius: var(--radius-lg);
}

.empty-products > span {
    color: var(--color-accent-600);

    font-size: var(--font-size-3xl);
}

.empty-products strong {
    margin-top: var(--space-3);

    color: var(--color-primary-900);

    font-size: var(--font-size-xl);
}

.empty-products p {
    margin-top: var(--space-2);

    color: var(--color-gray-500);
}

/* =========================================
   SKELETON
   ========================================= */

.skeleton-card {
    padding-bottom: var(--space-5);
}

.skeleton {
    position: relative;

    overflow: hidden;

    background: var(--color-gray-100);

    border-radius: var(--radius-sm);
}

.skeleton::after {
    content: "";

    position: absolute;

    inset: 0;

    background:
            linear-gradient(
                    90deg,
                    transparent,
                    rgb(255 255 255 / 0.7),
                    transparent
            );

    transform: translateX(-100%);

    animation:
            shimmer
            1.4s infinite;
}

.skeleton-image {
    aspect-ratio: 1 / 0.87;

    border-radius: 0;
}

.skeleton-line {
    height: 13px;

    margin:
            var(--space-4)
            var(--space-5)
            0;
}

.skeleton-line.short {
    width: 42%;
}

.skeleton-line.medium {
    width: 65%;
}

/* =========================================
   PHYSICAL STORE
   ========================================= */

.store-section {
    background: var(--color-white);
}

.store-card {
    min-height: 400px;

    display: grid;

    grid-template-columns:
    1.2fr
    0.8fr;

    align-items: center;

    gap: var(--space-12);

    padding: var(--space-12);

    background:
            radial-gradient(
                    circle at 90% 20%,
                    rgb(217 97 34 / 0.16),
                    transparent 30%
            ),
            var(--color-primary-900);

    border-radius: var(--radius-xl);

    overflow: hidden;
}

.section-eyebrow.light {
    color: #f0b98d;
}

.store-content h2 {
    max-width: 650px;

    margin-top: var(--space-3);

    color: var(--color-white);

    font-size:
            clamp(
                    2rem,
                    4vw,
                    3.2rem
            );

    line-height: 1.05;

    letter-spacing: -0.05em;
}

.store-content p {
    max-width: 600px;

    margin-top: var(--space-5);

    color: #b8c3d1;

    line-height: 1.75;
}

.store-actions {
    display: flex;

    gap: var(--space-4);

    margin-top: var(--space-8);
}

.store-primary,
.store-secondary {
    min-height: 46px;

    display: inline-flex;

    align-items: center;
    justify-content: center;

    padding:
            0
            var(--space-5);

    border-radius: var(--radius-md);

    font-size: var(--font-size-sm);
    font-weight: 800;
}

.store-primary {
    background: var(--color-accent-600);
    color: var(--color-white);
}

.store-primary:hover {
    background: var(--color-accent-700);
}

.store-secondary {
    color: var(--color-white);

    border:
            1px solid
            rgb(255 255 255 / 0.2);
}

.store-secondary:hover {
    background:
            rgb(255 255 255 / 0.08);
}

.store-visual {
    min-height: 270px;

    display: flex;
    flex-direction: column;

    align-items: center;
    justify-content: center;

    background:
            rgb(255 255 255 / 0.06);

    border:
            1px solid
            rgb(255 255 255 / 0.1);

    border-radius: var(--radius-xl);

    text-align: center;
}

.location-pin {
    position: relative;

    width: 62px;
    height: 62px;

    display: grid;
    place-items: center;

    background: var(--color-accent-600);

    border-radius:
            50%
            50%
            50%
            10%;

    transform: rotate(-45deg);
}

.location-pin span {
    width: 22px;
    height: 22px;

    background: var(--color-white);

    border-radius: 50%;
}

.store-visual strong {
    margin-top: var(--space-8);

    color: var(--color-white);

    font-size: var(--font-size-2xl);
}

.store-visual > span:not(.location-pin) {
    margin-top: 2px;

    color: #98a2b3;
}

.location-line {
    width: 70px;
    height: 1px;

    margin:
            var(--space-4)
            0;

    background:
            rgb(255 255 255 / 0.18);
}

.store-visual small {
    color: #f0b98d;

    font-weight: 700;
}

/* =========================================
   ANIMATIONS
   ========================================= */

@keyframes shimmer {
    100% {
        transform:
                translateX(100%);
    }
}

@keyframes pulseBackground {
    0%,
    100% {
        background-position: 0 0;
    }

    50% {
        background-position: 100% 0;
    }
}

/* =========================================
   RESPONSIVE
   ========================================= */

@media (max-width: 1050px) {

    .hero-grid {
        grid-template-columns:
      1fr
      0.85fr;

        gap: var(--space-8);
    }

    .hero-trust {
        gap: var(--space-5);
    }

    .benefits-grid {
        grid-template-columns:
      repeat(2, 1fr);
    }

    .benefit {
        min-height: 82px;

        border-bottom:
                1px solid
                var(--color-border);
    }

    .product-grid {
        grid-template-columns:
      repeat(3, 1fr);
    }
}

@media (max-width: 820px) {

    .hero-grid {
        grid-template-columns: 1fr;

        padding-top: var(--space-12);
        padding-bottom: var(--space-12);
    }

    .hero-content {
        text-align: center;
    }

    .hero-description {
        margin-left: auto;
        margin-right: auto;
    }

    .hero-actions,
    .hero-trust {
        justify-content: center;
    }

    .hero-showcase {
        min-height: 370px;
    }

    .category-grid {
        grid-template-columns: 1fr;
    }

    .product-grid {
        grid-template-columns:
      repeat(2, 1fr);
    }

    .store-card {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 560px) {

    .hero-content h1 {
        font-size: 2.7rem;
    }

    .hero-actions {
        flex-direction: column;
    }

    .hero-primary {
        width: 100%;
    }

    .hero-trust {
        display: none;
    }

    .hero-showcase {
        min-height: 310px;
    }

    .showcase-card {
        min-height: 310px;

        padding: var(--space-5);
    }

    .benefits-grid {
        grid-template-columns: 1fr;
    }

    .benefit {
        padding:
                var(--space-4)
                0;

        border-right: 0;
    }

    .categories-section,
    .products-section,
    .store-section {
        padding:
                var(--space-12)
                0;
    }

    .section-heading {
        align-items: flex-start;
        flex-direction: column;
    }

    .product-grid {
        grid-template-columns: 1fr;
    }

    .store-card {
        padding: var(--space-6);
    }

    .store-actions {
        flex-direction: column;
    }

    .store-primary,
    .store-secondary {
        width: 100%;
    }
}